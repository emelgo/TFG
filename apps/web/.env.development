# DEVELOPMENT-ONLY ENVIRONMENT VARIABLES
# These values are only used when running the app in development mode.

# SUPABASE (public → VITE_, inlined into the client bundle via import.meta.env)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLIC_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# SUPABASE SECRETS (server-only, stay unprefixed in process.env)
## THIS IS FOR DEVELOPMENT ONLY - DO NOT USE IN PRODUCTION
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
SUPABASE_DB_WEBHOOK_SECRET=WEBHOOKSECRET

# CMS: conexión directa a Postgres que usa la API del CMS (Drizzle +
# postgres.js) para su SQL dinámico. Es la cadena por defecto de la base de
# datos local que levanta la CLI de Supabase (no es un secreto). En producción
# se define aparte con la del proyecto real; si falta, la web arranca igual y
# solo fallan las rutas /api/cms/* con un error explícito.
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

