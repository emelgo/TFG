{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "start:test": "node --env-file-if-exists=.env.test .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "supabase": "supabase",
    "supabase:start": "supabase status || supabase start",
    "supabase:start:ci": "supabase status || supabase start -x studio,imgproxy,logflare,vector",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase db test",
    "supabase:build-initial-migration": "node supabase/scripts/build-initial-migration.mjs",
    "supabase:db:lint": "supabase db lint",
    "supabase:db:diff": "supabase db diff",
    "supabase:deploy": "supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push",
    "supabase:typegen": "supabase gen types typescript --local > ../../packages/supabase/src/database.types.ts",
    "supabase:db:dump:local": "supabase db dump --local --data-only"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
