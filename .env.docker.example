# Plantilla de variables para `docker compose` (docs/DESPLIEGUE.md).
# Copia este fichero a `.env.docker` (está ignorado por git y por Docker) y
# rellena los valores. NUNCA subas el `.env.docker` con secretos reales.
#
# Hay dos tipos de variables:
#   · BUILD  (VITE_*): públicas; Vite las incrusta en el código del navegador
#     al construir la imagen. Si cambian, hay que reconstruir (--build).
#   · RUNTIME (resto): solo de servidor; se leen al arrancar el contenedor.

# --- Puerto publicado en el anfitrión ---------------------------------------
# 3200 para no chocar con el servidor de desarrollo (3100).
WEB_PORT=3200

# =========================== BUILD (públicas) ================================
# URL pública con la que se accede a la app. En producción debe ser https;
# con http (prueba en local) hay que activar VITE_CI=true más abajo.
VITE_SITE_URL=http://localhost:3200
# URL del proyecto Supabase (nube: https://<ref>.supabase.co;
# local: http://127.0.0.1:54321, con docker-compose.supabase-local.yml).
VITE_SUPABASE_URL=
# Clave pública («publishable», sb_publishable_…). Es pública por diseño:
# la seguridad la ponen las políticas RLS.
VITE_SUPABASE_PUBLIC_KEY=
# Clave publicable de Stripe en modo test (pk_test_…). Vacía si no hay pagos.
VITE_STRIPE_PUBLISHABLE_KEY=
# Opcionales: si se dejan vacías se usan los valores de apps/web/.env.
VITE_BILLING_PROVIDER=
VITE_PRODUCT_NAME=
VITE_DEFAULT_LOCALE=
VITE_ACCOUNT_MODE=
VITE_CAPTCHA_SITE_KEY=
# true solo para probar en local con http://; en producción, vacío.
VITE_CI=true

# ====================== RUNTIME (servidor, secretos) =========================
# Nota: compose pasa al contenedor TODO este fichero (env_file), así que las
# VITE_* de arriba también están disponibles en runtime; la API del CMS lee de
# ahí VITE_SUPABASE_URL y VITE_SUPABASE_PUBLIC_KEY si no las trae la build.

# Clave secreta de Supabase (sb_secret_…). Ignora RLS: solo servidor.
SUPABASE_SECRET_KEY=
# Secreto compartido de los webhooks de base de datos (mismo valor que el
# configurado en Supabase para los database webhooks).
SUPABASE_DB_WEBHOOK_SECRET=
# Conexión directa a Postgres para la API del CMS (Drizzle). En la nube, la
# cadena «Session pooler» del proyecto; en local,
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DATABASE_URL=

# Stripe (modo test): clave secreta y secreto de firma del webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# embedded_page (por defecto) | hosted_page
STRIPE_UI_MODE=embedded_page

# Correo saliente
MAILER_PROVIDER=nodemailer
EMAIL_SENDER="PymeKit <no-reply@example.com>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TLS=true
EMAIL_USER=
EMAIL_PASSWORD=
# Solo si MAILER_PROVIDER=resend
RESEND_API_KEY=
# Destinatario del formulario de contacto
CONTACT_EMAIL=

# Captcha (opcional; secreto de servidor del widget)
CAPTCHA_SECRET_TOKEN=
